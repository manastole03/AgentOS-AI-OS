# Runtime
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL / pgvector
POSTGRES_DB=healthos
POSTGRES_USER=healthos
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql+asyncpg://healthos:change-me@postgres:5432/healthos

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=56379

# JWT - replace in every deployed environment (minimum 32 characters)
JWT_SECRET_KEY=replace-this-with-at-least-32-random-characters
JWT_REFRESH_SECRET_KEY=replace-this-with-a-different-32-character-secret
OTP_SECRET_KEY=replace-this-with-another-32-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=healthos
JWT_AUDIENCE=healthos-api
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# OTP email delivery (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Clinical and operational integrations
OCR_API_URL=
OCR_API_KEY=
FHIR_BASE_URL=
FHIR_ACCESS_TOKEN=
INSURANCE_API_URL=
INSURANCE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_URL=
JOB_WATCH_SCAN_INTERVAL_SECONDS=300
DOCUMENT_MAX_BYTES=10485760

# Service discovery
API_SERVICE_URL=http://api:8000
AI_SERVICE_URL=http://ai:8001

# AI provider gateway and encrypted persistence
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=openai/gpt-5.4
ANTHROPIC_MODEL=anthropic/claude-opus-5
GEMINI_MODEL=gemini/gemini-2.5-pro
LITELLM_MASTER_KEY=replace-with-at-least-32-random-characters
LITELLM_BASE_URL=http://litellm:4000/v1
AI_DATA_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
LANGGRAPH_AES_KEY=replace-with-a-32-byte-aes-key
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=healthos
OTEL_EXPORTER_OTLP_ENDPOINT=

# Browser-visible configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
