            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "chunk_count"
        ],
        "title": "DocumentResponse",
        "type": "object"
      },
      "EvidenceCitation": {
        "properties": {
