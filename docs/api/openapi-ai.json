{
  "components": {
    "schemas": {
      "ActionConfirmation": {
        "properties": {
          "confirmation_token": {
            "maxLength": 255,
            "minLength": 32,
            "title": "Confirmation Token",
            "type": "string"
          },
          "payload_digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Payload Digest",
            "type": "string"
          }
        },
        "required": [
          "confirmation_token",
          "payload_digest"
        ],
        "title": "ActionConfirmation",
        "type": "object"
      },
      "ActionProposalCreate": {
        "properties": {
          "action_type": {
            "pattern": "^(hold_slot|book|reschedule|verify_eligibility|estimate_cost|submit_claim|submit_prior_authorization|purchase_policy|draft_clinical_document|draft_medical_codes)$",
            "title": "Action Type",
            "type": "string"
          },
          "affected_resources": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Affected Resources",
            "type": "array"
          },
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceCitation"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "expires_in_seconds": {
            "default": 900,
            "maximum": 3600.0,
            "minimum": 60.0,
            "title": "Expires In Seconds",
            "type": "integer"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "action_type",
          "arguments",
          "evidence"
        ],
        "title": "ActionProposalCreate",
        "type": "object"
      },
      "ActionProposalResponse": {
        "properties": {
          "action_type": {
            "title": "Action Type",
            "type": "string"
          },
          "affected_resources": {
            "items": {
              "type": "string"
            },
            "title": "Affected Resources",
            "type": "array"
          },
          "confirmation_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
