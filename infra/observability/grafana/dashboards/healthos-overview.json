{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Request rate",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(healthos_http_requests_total[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx rate",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(healthos_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(healthos_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI runs",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (status, team) (increase(healthos_ai_runs_total[5m]))",
          "legendFormat": "{{team}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "In-flight requests",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (service) (healthos_http_requests_in_flight)",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["healthos", "hipaa"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "HealthOS Production Overview",
  "uid": "healthos-overview",
  "version": 1
}
